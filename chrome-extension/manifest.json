{
  "manifest_version": 3,
  "name": "Buscador de Fornecedores Amazon",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "120",
  "description": "Consulta produtos da Motion e da SMC Pneumatics na sessão deste Chrome.",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.motion.com/*",
    "https://www.smcpneumatics.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
