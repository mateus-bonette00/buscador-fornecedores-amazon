[Unit]
Description=Buscador de Fornecedores Amazon (painel local)

[Service]
Type=simple
WorkingDirectory=%h/.local/share/buscador-fornecedores-amazon
ExecStart=/usr/bin/env node %h/.local/share/buscador-fornecedores-amazon/server/index.js
UMask=0077
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=default.target
