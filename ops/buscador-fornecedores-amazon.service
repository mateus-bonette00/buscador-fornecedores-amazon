[Unit]
Description=Buscador de Fornecedores Amazon (painel local)

[Service]
Type=simple
WorkingDirectory=%h/.local/share/buscador-fornecedores-amazon
ExecStart=/usr/bin/python3 %h/.local/share/buscador-fornecedores-amazon/app.py
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=default.target
